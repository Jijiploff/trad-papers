# =============================================================================
# Archivo de configuración - Paper Translator
# =============================================================================
# Copia este archivo a `config.yaml` y completa con tus credenciales.
# También puedes usar variables de entorno que tienen prioridad:
#   - GEMINI_API_KEY
#   - DEEPL_API_KEY
#   - OPENAI_API_KEY
#
# SISTEMA DE FALLBACK AUTOMÁTICO:
#   1. Gemini (primario, GRATIS 1M tokens/día)
#   2. DeepL (secundario, free tier 500K chars/mes)
#   3. OpenAI (terciario, pago por uso)
#
# Si el proveedor primario se agota o falla, pasa automáticamente al siguiente.
# =============================================================================

# =============================================================================
# Configuración general de la aplicación
# =============================================================================
app:
  name: "Paper Translator"
  max_files: 20                    # Máximo de archivos simultáneos
  max_file_size_mb: 50             # Tamaño máximo por archivo en MB
  cache_dir: "cache"               # Directorio para caché de traducciones
  log_dir: "logs"                  # Directorio para archivos de log
  export_dir: "exports"            # Directorio para archivos exportados

# =============================================================================
# Parámetros de traducción
# =============================================================================
translation:
  chunk_size_tokens: 3500          # Tamaño máximo de fragmento (tokens)
  chunk_overlap_tokens: 200        # Solapamiento entre fragmentos
  max_workers: 4                   # Hilos para procesamiento paralelo
  request_timeout_seconds: 120     # Timeout por solicitud a API
  max_retries: 3                   # Reintentos en caso de fallo
  retry_delay_seconds: 2           # Espera entre reintentos (base)
  rate_limit_delay_seconds: 1.0    # Pausa mínima entre solicitudes
  source_lang: "EN"                # Idioma origen
  target_lang: "ES"                # Idioma destino

# =============================================================================
# Proveedores de traducción (orden de prioridad: Gemini -> DeepL -> OpenAI)
# =============================================================================
providers:

  # --- Google Gemini API (PRIMARIO - GRATIS) ---
  # 1 MILLÓN de tokens por día GRATIS. Sin tarjeta de crédito requerida.
  # Obtén tu API key en: https://aistudio.google.com/apikey
  gemini:
    api_key: ""                     # Tu API key de Google AI Studio
    model: "gemini-1.5-flash"       # gemini-1.5-flash (gratis), gemini-1.5-pro
    temperature: 0.2

  # --- DeepL API (SECUNDARIO - Fallback automático) ---
  # Se usa AUTOMÁTICAMENTE si Gemini se agota o falla.
  # Plan gratuito: 500,000 caracteres/mes.
  # Obtén API key en: https://www.deepl.com/pro-api
  deepl:
    api_key: ""                     # Tu API key de DeepL
    # Plan gratuito:  https://api-free.deepl.com/v2
    # Plan Pro:       https://api.deepl.com/v2
    base_url: "https://api-free.deepl.com/v2"
    formality: "default"            # default / more / less / prefer_more / prefer_less

  # --- OpenAI GPT-4o (TERCIARIO - último recurso) ---
  # Solo se usa si Gemini y DeepL fallan. Pago por uso.
  # Obtén API key en: https://platform.openai.com/
  openai:
    api_key: ""                     # Tu API key de OpenAI (opcional)
    model: "gpt-4o-mini"            # gpt-4o-mini (económico), gpt-4o (premium)
    base_url: "https://api.openai.com/v1"
    temperature: 0.3
